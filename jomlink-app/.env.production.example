# ─────────────────────────────────────────────────────────────
# JOMLINK — Production environment (VPS)
#
# Copy to `.env` on the server and replace every value with a REAL one:
#   cp .env.production.example .env
#
# ⚠ SECURITY (Sentinel-AI):
#   • .env contains live secrets — set file perms to 600, never commit it.
#   • NEXT_PUBLIC_* vars are inlined into the build, so they must be
#     present when running `docker compose build`.
#   • SUPABASE_SERVICE_ROLE_KEY grants privileged server-side DB access —
#     server-only, never exposed to the browser.
#   • TOYYIBPAY_SECRET_KEY must point at your LIVE gateway key for real
#     payments (sandbox key rejects live bill creation).
# ─────────────────────────────────────────────────────────────

# --- Supabase (self-hosted, PostgREST data layer) ----------------------
NEXT_PUBLIC_SUPABASE_URL=https://supabase.your-domain.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App public URL (callback paths are built from this) ---------------
# Use the HTTPS domain your nginx is serving — ToyyibPay callbacks must
# reach it from the internet (needs a real domain + tunnel if behind NAT).
NEXT_PUBLIC_APP_URL=https://jomlink.com

# --- ToyyibPay (Malaysian gateway, FPX+card) ---------------------------
# Live: https://toyyibpay.com   |   Sandbox: https://dev.toyyibpay.com
TOYYIBPAY_BASE_URL=https://toyyibpay.com
TOYYIBPAY_SECRET_KEY=your-live-secret-key
TOYYIBPAY_CATEGORY_CODE=your-category-code

# --- AML / KYC gate (blueprint §11.9.2) --------------------------------
# KYC_DEV_BYPASS lets dev/QA skip the KYC-before-payout gate. It is HARD-BLOCKED
# when NODE_ENV=production (see src/lib/kyc-dev-bypass.ts), so setting it here has
# no effect — it is listed only so nobody invents a different switch.
# Leave it unset/false in production.
# KYC_DEV_BYPASS=
