# ─────────────────────────────────────────────────────────────
# JOMLINK — Environment Variables SAMPLE
# Copy to `.env.local` and fill in your real values.
# NEVER commit `.env.local` with real secrets.
# ─────────────────────────────────────────────────────────────

# Supabase Auth provider
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SERVER-ONLY, never expose to client

# PostgreSQL for the Prisma business-data layer
DATABASE_URL=postgresql://user:password@localhost:5432/jomlink

# Business rules (apply the correct decimal values)
NEXT_PUBLIC_ACTIVATION_FEE_RATE=0.10
NEXT_PUBLIC_LINKER_SERVICE_FEE_RATE=0.03
RELEASE_WAIT_DAYS=7
DEFAULT_CURRENCY=MYR